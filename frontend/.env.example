# Local dev default matches the Flask backend (backend/app.py PORT fallback).
REACT_APP_API_URL=http://localhost:5001
# On Vercel, set REACT_APP_API_URL to the deployed frontend origin so API
# calls stay same-origin and ride the vercel.json rewrites to Render:
# REACT_APP_API_URL=https://<your-app>.vercel.app
