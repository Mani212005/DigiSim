# react-scripts@5.0.1 declares a peerOptional on typescript@^3.2.1 || ^4
# but this project uses typescript@^5.9.3. Stock `npm install` / `npm ci`
# (Netlify, Azure Oryx) fail with ERESOLVE on that conflict. The GitHub
# workflow already works around it with --legacy-peer-deps; this file makes
# every other installer (Netlify, Oryx, local dev) resolve the same way.
legacy-peer-deps=true
